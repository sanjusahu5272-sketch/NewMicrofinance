# =============================================================================
# .env.production.example — Copy to .env.production and fill in real values
# =============================================================================

# ── App ──
APP_NAME="NEEV 4D Microfinance SaaS ERP"
APP_ENV=production
APP_KEY=              # Generate: php artisan key:generate --no-interaction
APP_DEBUG=false
APP_TIMEZONE=Asia/Kolkata
APP_URL=https://your-domain.com

# ── Logging ──
LOG_CHANNEL=stack
LOG_LEVEL=info
LOG_DEPRECATIONS_CHANNEL=null

# ── Database (PostgreSQL 17) ──
# App connects as a NON-OWNER, NON-SUPERUSER role so Row Level Security applies.
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=neev_mfi_prod
DB_USERNAME=neev_mfi
DB_PASSWORD=              # Strong password, 32+ chars
DB_SCHEMA=public
DB_SSLMODE=prefer

# ── Redis (queue + cache + Horizon metrics) ──
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null
QUEUE_CONNECTION=redis
CACHE_STORE=redis
SESSION_DRIVER=redis

# ── Multi-Tenant SaaS & Security ──
NEEV_ENV=production
NEEV_DEFAULT_TENANT=TNT-NEEV-01
NEEV_JWT_SECRET=          # Generate: openssl rand -hex 32
NEEV_KYC_ENC_KEY=         # Generate: openssl rand -hex 32
# Must be empty in production
NEEV_BRANCH_DEFAULT_PASSWORD=

# ── RBI Microfinance Regulatory Limits ──
MFI_MAX_FOIR_PCT=50.00
MFI_ANNUAL_HOUSEHOLD_INCOME_MIN=300000.00
MFI_DEFAULT_GST_PCT=18.00

# ── TOTP / 2FA ──
MFI_TOTP_ISSUER="NEEV 4D Microfinance"

# ── Breached Password Check (optional, HIBP k-anonymity) ──
MFI_PASSWORD_BREACH_CHECK=false

# ── Payment Gateways (Cashfree / RazorpayX / eNACH) ──
CASHFREE_ENV=PRODUCTION
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_WEBHOOK_SECRET=

# ClamAV malware scanning (optional but recommended)
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
CLAMAV_TIMEOUT=10
