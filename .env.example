APP_NAME="NEEV 4D Microfinance SaaS ERP"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Kolkata
APP_URL=https://erp.microfincare.com

LOG_CHANNEL=stack
LOG_LEVEL=info

# PostgreSQL Core Banking Database Configuration
# DB_CONNECTION: pgsql only. The app must NOT connect as a superuser or the
# table owner — either one silently bypasses Row Level Security.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=neev_mfi_prod
DB_USERNAME=neev_mfi
DB_PASSWORD=
DB_SCHEMA=public
DB_SSLMODE=prefer

# Multi-Tenant SaaS & Security Configuration
NEEV_ENV=production
NEEV_DEFAULT_TENANT=TNT-NEEV-01
NEEV_JWT_SECRET=
NEEV_KYC_ENC_KEY=
# Must be empty in production: users are forced to set a real password on first login.
NEEV_BRANCH_DEFAULT_PASSWORD=

# RBI Microfinance Regulatory Limits
MFI_MAX_FOIR_PCT=50.00
MFI_ANNUAL_HOUSEHOLD_INCOME_MIN=300000.00
MFI_DEFAULT_GST_PCT=18.00

# Payment Gateways (Cashfree Payouts / RazorpayX / eNACH)
CASHFREE_ENV=PRODUCTION
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_WEBHOOK_SECRET=
RAZORPAYX_KEY_ID=
RAZORPAYX_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# SMS DLT & WhatsApp Business API
SMS_PROVIDER_ENABLED=false
SMS_DLT_ENTITY_ID=1201159000000012345
