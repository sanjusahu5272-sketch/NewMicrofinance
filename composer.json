{
    "name": "neev4d/microfinance-saas-erp",
    "type": "project",
    "description": "NEEV 4D Multi-Tenant SaaS Microfinance Core Banking ERP (Individual & Product Loans, Actuarial KFS Engine, Double-Entry GL, PostgreSQL)",
    "keywords": [
        "laravel",
        "microfinance",
        "nbfc-mfi",
        "saas",
        "postgresql",
        "core-banking",
        "individual-loan",
        "product-loan"
    ],
    "license": "proprietary",
    "require": {
        "php": "^8.5",
        "ext-bcmath": "*",
        "ext-json": "*",
        "ext-pdo": "*",
        "ext-pdo_pgsql": "*",
        "laravel/framework": "^13.0",
        "laravel/horizon": "^5.50",
        "laravel/sanctum": "^4.0",
        "laravel/tinker": "^3.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.13",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.5",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^13.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "scripts": {
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php artisan migrate --seed --ansi"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    }
}
